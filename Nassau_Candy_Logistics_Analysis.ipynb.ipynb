import pandas as pd

import numpy as np

import matplotlib.pyplot as plt

import seaborn as sns

from datetime import datetime

df = pd.read_csv('/content/Nassau Candy Distributor.csv')

df.head()

df.info()

df.describe()

df.isnull().sum()

df["Order Date"] = pd.to_datetime(df['Order Date'], format='%d-%m-%Y')

df['Ship Date'] = pd.to_datetime(df['Ship Date'], format='%d-%m-%Y')

df["Lead_time"] = (df["Ship Date"] - df["Order Date"]).dt.days

df = df[df['Lead_time'] >=0]

factory_map = {
"Wonka Bar - Nutty Crunch Surprise": "Lot's O' Nuts",
"Wonka Bar - Fudge Mallows": "Lot's O' Nuts",
"Wonka Bar -Scrumdiddlyumptious": "Lot's O' Nuts",
"Wonka Bar - Milk Chocolate": "Wicked Choccy's",
"Wonka Bar - Triple Dazzle Caramel": "Wicked Choccy's",
"Laffy Taffy": "Sugar Shack",
"SweeTARTS": "Sugar Shack",
"Nerds": "Sugar Shack",
"Fun Dip": "Sugar Shack",
"Fizzy Lifting Drinks": "Sugar Shack",
"Everlasting Gobstopper": "Secret Factory",
"Hair Toffee": "The Other Factory",
"Lickable Wallpaper": "Secret Factory",
"Wonka Gum": "Secret Factory",
"Kazookles": "The Other Factory"
}

df['Factory'] = df['Product Name'].map(factory_map)

df['Factory'].isnull().sum()

df['Route_State'] = df['Factory'] + " → " + df['State/Province']
df['Route_Region'] = df['Factory'] + " → " + df['Region']

Route_state = df.groupby('Route_State').agg(Total_Shipments=('Order ID','count'),Avg_Lead_time=('Lead_time','mean'),Std_Lead_time=('Lead_time','std')).reset_index()

route_state_sorted = Route_state.sort_values('Avg_Lead_time')

top10 = route_state_sorted.head(10)
bottom10 = route_state_sorted.tail(10)

df['Delayed'] = np.where(df['Lead_time']> 5,1,0)

delay_rate = df.groupby('Route_State')['Delayed'].mean()*100

Route_state['Efficiency_Score'] = (
    1 - (Route_state['Avg_Lead_time'] - Route_state['Avg_Lead_time'].min()) / (Route_state['Avg_Lead_time'].max() - Route_state['Avg_Lead_time'].min()))

shipmode_perf = df.groupby('Ship Mode')['Lead_time'].mean()
shipmode_perf.plot(kind='bar')
plt.title("Avg Lead Time by Ship Mode")
plt.show()

state_perf = df.groupby('State/Province')['Lead_time'].mean().sort_values(ascending=False)
state_perf.head(10)

pivot = pd.pivot_table(df,
                        values='Lead_time',
                        index='Region',
                        columns='Ship Mode',
                        aggfunc='mean')

sns.heatmap(pivot, annot=True, cmap='Reds')
plt.show()

df.to_csv("cleaned_nassau.csv", index=False)
Route_state.to_csv("route_state_kpis.csv", index=False)